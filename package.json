{
  "name": "jupiter-qda",
  "version": "1.0.0",
  "license": "ISC",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:electron\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && env/bin/python -m uvicorn app.main:app --reload --port 8000",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "start": "electron .",
    "build:backend": "cd backend && env/bin/pyinstaller jupiter-backend.spec",
    "build:react": "cd frontend && npm run build",
    "build:win": "npm run build:react && electron-builder --win",
    "build:mac": "npm run build:react && electron-builder --mac",
    "build:linux": "npm run build:react && electron-builder --linux",
    "test": "npm run test:backend",
    "test:backend": "cd backend && env/bin/python -m pytest"
  },
  "keywords": [],
  "author": "",
  "description": "Qualitative Data Analysis Tool",
  "devDependencies": {
    "concurrently": "^9.2.3",
    "electron": "^41.2.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "pdfjs-dist": "^5.6.205",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.12.1"

  },
  "build": {
    "appId": "com.jupiter.qda",
    "productName": "jUPiter QDA",
    "directories": {
      "output": "release/"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "frontend/dist/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/jupiter-backend",
        "to": "backend/jupiter-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/logo.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/logo.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/logo.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
